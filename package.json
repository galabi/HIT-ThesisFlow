{
  "name": "hit-thesisflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "lint": "eslint . --ext .js,.jsx --ignore-path .eslintignore",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\"",
    "db:migrate": "npm run prisma:migrate -w server",
    "db:seed": "npm run prisma:seed -w server",
    "db:studio": "npm run prisma:studio -w server",
    "test": "npm run test -w server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "prettier": "^3.3.2"
  }
}

# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────
# Local (Docker, no auth): mongodb://localhost:27017/hit_thesisflow?replicaSet=rs0&directConnection=true
# MongoDB Atlas:           mongodb+srv://user:pass@cluster.mongodb.net/hit_thesisflow
DATABASE_URL=mongodb://localhost:27017/hit_thesisflow?replicaSet=rs0&directConnection=true

# ── JWT ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── File Storage (Cloudflare R2 / AWS S3) ────────────────
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=hit-thesisflow
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@hit-thesisflow.ac.il
